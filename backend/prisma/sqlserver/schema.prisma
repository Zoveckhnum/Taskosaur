// ============= AI CHAT CONVERSATIONS =============
model Conversation {
  id        String        @id @default(uuid()) @db.UniqueIdentifier
  title     String        @default("New Chat")
  sessionId String        @map("session_id") @unique @db.NVarChar(255)
  userId    String        @map("user_id") @db.UniqueIdentifier
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  messages  ChatMessage[]
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@index([userId])
  @@index([updatedAt])
  @@map("conversations")
}

model ChatMessage {
  id             String       @id @default(uuid()) @db.UniqueIdentifier
  role           String       // "user", "assistant", or "system"
  content        String       @db.NVarChar(Max)
  conversationId String       @map("conversation_id") @db.UniqueIdentifier
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([conversationId])
  @@index([createdAt])
  @@map("chat_messages")
}

