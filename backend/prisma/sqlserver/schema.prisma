// ============= PROJECT INBOX MODELS =============
model ProjectInbox {
  id        String @id @default(uuid()) @db.UniqueIdentifier
  projectId String @unique @map("project_id") @db.UniqueIdentifier

  // Basic Configuration
  enabled     Boolean @default(true)
  name        String
  description String?

  // Email Settings
  emailAddress      String? @unique @map("email_address") @db.NVarChar(255)
  emailSignature    String? @map("email_signature")
  autoReplyEnabled  Boolean @default(false) @map("auto_reply_enabled")
  autoReplyTemplate String? @map("auto_reply_template")

  // Processing Rules
  autoCreateTask    Boolean      @default(true) @map("auto_create_task")
  defaultTaskType   String     @default("TASK") @map("default_task_type") @db.NVarChar(64)
  defaultPriority   String @default("MEDIUM") @map("default_priority") @db.NVarChar(64)
  defaultStatusId   String       @map("default_status_id") @db.UniqueIdentifier
  defaultAssigneeId String?      @map("default_assignee_id") @db.UniqueIdentifier
  syncInterval      Int?         @map("sync_interval")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  defaultStatus   TaskStatus     @relation(fields: [defaultStatusId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  defaultAssignee User?          @relation("InboxDefaultAssignee", fields: [defaultAssigneeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  emailAccount    EmailAccount?
  messages        InboxMessage[]
  rules           InboxRule[]

  @@map("project_inboxes")
  @@index([projectId])
  @@index([defaultStatusId])
  @@index([defaultAssigneeId])
}

model EmailAccount {
  id             String @id @default(uuid()) @db.UniqueIdentifier
  projectInboxId String @unique @map("project_inbox_id") @db.UniqueIdentifier

  emailAddress String  @unique @map("email_address") @db.NVarChar(255)
  displayName  String? @map("display_name")

  // Basic Auth (IMAP/SMTP)
  imapHost            String? @map("imap_host")
  imapPort            Int?    @default(993) @map("imap_port")
  imapUsername        String? @map("imap_username")
  imapPassword        String? @map("imap_password") // Encrypted
  imapUseSsl          Boolean @default(true) @map("imap_use_ssl")
  imapTlsRejectUnauth Boolean @default(true) @map("imap_tls_reject_unauthorized")
  imapTlsMinVersion   String? @default("TLSv1.2") @map("imap_tls_min_version")
  imapServername      String? @map("imap_servername") // SNI hostname for TLS validation
  imapFolder          String  @default("INBOX") @map("imap_folder")

  smtpHost            String? @map("smtp_host")
  smtpPort            Int?    @default(587) @map("smtp_port")
  smtpUsername        String? @map("smtp_username")
  smtpPassword        String? @map("smtp_password") // Encrypted
  smtpTlsRejectUnauth Boolean @default(true) @map("smtp_tls_reject_unauthorized")
  smtpTlsMinVersion   String? @default("TLSv1.2") @map("smtp_tls_min_version")
  smtpServername      String? @map("smtp_servername") // SNI hostname for TLS validation
  smtpRequireTls      Boolean @default(false) @map("smtp_require_tls") // Force STARTTLS

  // Sync State
  syncEnabled   Boolean   @default(true) @map("sync_enabled")
  lastSyncAt    DateTime? @map("last_sync_at")
  lastSyncError String?   @map("last_sync_error")

  // IMAP State
  uidValidity   String? @map("uid_validity")
  uidNext       Int?    @map("uid_next")
  highestModSeq String? @map("highest_mod_seq")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  projectInbox ProjectInbox @relation(fields: [projectInboxId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("email_accounts")
  @@index([projectInboxId])
}

model InboxMessage {
  id             String @id @default(uuid()) @db.UniqueIdentifier
  projectInboxId String @map("project_inbox_id") @db.UniqueIdentifier

  // Email Identity
  messageId  String   @unique @map("message_id") @db.NVarChar(255)
  imapUid    BigInt?  @map("imap_uid")
  threadId   String   @map("thread_id") @db.NVarChar(255)
  inReplyTo  String?  @map("in_reply_to")
  references String @db.NVarChar(Max) @default("[]")

  // Content
  subject   String
  fromEmail String   @map("from_email")
  fromName  String?  @map("from_name")
  toEmails  String @map("to_emails") @db.NVarChar(Max) @default("[]")
  ccEmails  String @map("cc_emails") @db.NVarChar(Max) @default("[]")
  bccEmails String @map("bcc_emails") @db.NVarChar(Max) @default("[]")
  replyTo   String?  @map("reply_to")

  bodyText      String? @map("body_text") @db.NVarChar(Max)
  bodyHtml      String? @map("body_html") @db.NVarChar(Max)
  textSignature String? @map("text_signature") @db.NVarChar(Max)
  htmlSignature String? @map("html_signature") @db.NVarChar(Max)
  snippet       String? @db.NVarChar(Max)

  // Metadata
  headers        String @db.NVarChar(Max)
  rawSize        Int?    @map("raw_size")
  hasAttachments Boolean @default(false) @map("has_attachments")
  importance     String?
  converted      Boolean @default(false)

  // Processing
  status    String @default("PENDING") @db.NVarChar(64)
  isSpam    Boolean       @default(false) @map("is_spam")
  spamScore Float?        @map("spam_score")

  convertedAt DateTime? @map("converted_at")
  convertedBy String?   @map("converted_by") @db.UniqueIdentifier

  // Timestamps
  emailDate   DateTime  @map("email_date")
  receivedAt  DateTime  @default(now()) @map("received_at")
  processedAt DateTime? @map("processed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  projectInbox    ProjectInbox        @relation(fields: [projectInboxId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  task            Task?
  convertedByUser User?               @relation(fields: [convertedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attachments     MessageAttachment[]
  ruleResults     MessageRuleResult[]

  @@unique([projectInboxId, imapUid])
  @@index([threadId])
  @@index([status])
  @@index([emailDate])
  @@index([imapUid])
  @@map("inbox_messages")
  @@index([convertedBy])
}

model MessageAttachment {
  id        String @id @default(uuid()) @db.UniqueIdentifier
  messageId String @map("message_id") @db.UniqueIdentifier

  filename  String
  mimeType  String  @map("mime_type")
  size      Int
  contentId String? @map("content_id")

  storagePath String  @map("storage_path")
  storageUrl  String? @map("storage_url")

  createdAt DateTime @default(now()) @map("created_at")

  message InboxMessage @relation(fields: [messageId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("message_attachments")
  @@index([messageId])
}

model InboxRule {
  id             String @id @default(uuid()) @db.UniqueIdentifier
  projectInboxId String @map("project_inbox_id") @db.UniqueIdentifier

  name        String
  description String?
  priority    Int     @default(0)
  enabled     Boolean @default(true)

  conditions String @db.NVarChar(Max)
  actions    String @db.NVarChar(Max)

  stopOnMatch Boolean @default(false) @map("stop_on_match")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  projectInbox ProjectInbox        @relation(fields: [projectInboxId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ruleResults  MessageRuleResult[]

  @@index([projectInboxId, enabled, priority])
  @@map("inbox_rules")
}

model MessageRuleResult {
  id        String @id @default(uuid()) @db.UniqueIdentifier
  messageId String @map("message_id") @db.UniqueIdentifier
  ruleId    String @map("rule_id") @db.UniqueIdentifier

  priority   String?  @db.NVarChar(64) // Priority to apply when creating task
  assigneeId String?       @map("assignee_id") @db.UniqueIdentifier // Assignee to assign task to
  labelIds   String      @map("label_ids")  @db.NVarChar(Max) @default("[]") // Labels to add to task
  taskType   String?       @map("task_type") // Task type to use

  matched Boolean @default(true) // Whether rule matched (for audit)
  stopped Boolean @default(false) // Whether this rule stopped further processing

  createdAt DateTime @default(now()) @map("created_at")

  message InboxMessage @relation(fields: [messageId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  rule    InboxRule    @relation(fields: [ruleId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([messageId])
  @@index([ruleId])
  @@map("message_rule_results")
}

model EmailSyncLog {
  id        String @id @default(uuid()) @db.UniqueIdentifier
  projectId String @map("project_id") @db.UniqueIdentifier

  startedAt         DateTime   @map("started_at")
  completedAt       DateTime?  @map("completed_at")
  status            String @db.NVarChar(64)
  error             String?    @db.NVarChar(Max)
  messagesProcessed Int        @default(0) @map("messages_processed")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([projectId, startedAt])
  @@map("email_sync_logs")
}

// ============= TRELLO SYNC =============
model TrelloSync {
  id          String  @id @default(uuid()) @db.UniqueIdentifier
  projectId   String? @unique @map("project_id") @db.UniqueIdentifier
  workspaceId String? @unique @map("workspace_id") @db.UniqueIdentifier

  // Trello connection
  trelloWorkspaceId String? @map("trello_workspace_id")
  trelloBoardId     String? @map("trello_board_id")
  trelloApiKey      String  @map("trello_api_key") // AES-256-GCM encrypted
  trelloToken       String  @map("trello_token") // AES-256-GCM encrypted

  // Sync configuration
  syncEnabled  Boolean @default(true) @map("sync_enabled")
  syncInterval Int     @default(15) @map("sync_interval") // minutes

  // Status tracking
  lastSyncAt     DateTime?   @map("last_sync_at")
  lastSyncStatus String? @map("last_sync_status") @db.NVarChar(64)
  lastSyncError  String?     @map("last_sync_error") @db.NVarChar(Max)
  cardsImported  Int         @default(0) @map("cards_imported")

  // List → Status mappings: { trelloListId: taskosaurStatusId }
  statusMappings String? @map("status_mappings") @db.NVarChar(Max)

  createdBy String?  @map("created_by_id") @db.UniqueIdentifier
  updatedBy String?  @map("updated_by_id") @db.UniqueIdentifier
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project       Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workspace     Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdByUser User?      @relation("TrelloSyncCreatedBy", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updatedByUser User?      @relation("TrelloSyncUpdatedBy", fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([workspaceId])
  @@map("trello_syncs")
  @@index([projectId])
  @@index([createdBy])
  @@index([updatedBy])
}

// ============= JIRA SYNC =============
model JiraSync {
  id          String  @id @default(uuid()) @db.UniqueIdentifier
  projectId   String? @unique @map("project_id") @db.UniqueIdentifier
  workspaceId String? @unique @map("workspace_id") @db.UniqueIdentifier

  // Jira connection
  jiraSiteUrl    String  @map("jira_site_url")    // e.g. https://org.atlassian.net
  jiraProjectKey String? @map("jira_project_key") // e.g. PROJ
  jiraEmail      String  @map("jira_email")       // AES-256-GCM encrypted
  jiraApiToken   String  @map("jira_api_token")   // AES-256-GCM encrypted

  // Sync configuration
  syncEnabled  Boolean @default(true) @map("sync_enabled")
  syncInterval Int     @default(15) @map("sync_interval") // minutes

  // Status tracking
  lastSyncAt     DateTime?   @map("last_sync_at")
  lastSyncStatus String? @map("last_sync_status") @db.NVarChar(64)
  lastSyncError  String?     @map("last_sync_error") @db.NVarChar(Max)
  issuesImported Int         @default(0) @map("issues_imported")

  // Jira status → Taskosaur status mappings: { jiraStatusId: taskosaurStatusId }
  statusMappings String? @map("status_mappings") @db.NVarChar(Max)

  createdBy String?  @map("created_by_id") @db.UniqueIdentifier
  updatedBy String?  @map("updated_by_id") @db.UniqueIdentifier
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project       Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workspace     Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdByUser User?      @relation("JiraSyncCreatedBy", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updatedByUser User?      @relation("JiraSyncUpdatedBy", fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([workspaceId])
  @@map("jira_syncs")
  @@index([projectId])
  @@index([createdBy])
  @@index([updatedBy])
}

model Settings {
  id          String   @id @default(uuid()) @db.UniqueIdentifier
  key         String
  value       String?
  description String?
  category    String   @default("general")
  isEncrypted Boolean  @default(false) @map("is_encrypted")
  userId      String?  @db.UniqueIdentifier // Optional - if null, it's a global setting
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  // Unique constraint: key must be unique per user (or globally if userId is null)
  @@unique([userId, key]) // This allows same keys for different users, and also allows global settings (userId = null)
  @@map("settings")
}

// ============= MEDIA ASSETS =============
model MediaAsset {
  id         String   @id @default(uuid()) @db.UniqueIdentifier
  userId     String   @db.UniqueIdentifier
  assetType  String @db.NVarChar(255) // "editor-image", "avatar", "attachment", etc.
  storageKey String // Full storage path (e.g., "editor-images/uuid-timestamp.png")
  filename   String // Original filename (for display purposes)
  mimeType   String // File type (image/png, etc.)
  size       Int // File size in bytes
  fileHash   String? // SHA-256 hash for future deduplication
  inCloud    Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@index([assetType])
  @@map("media_assets")
}

