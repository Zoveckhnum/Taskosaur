  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("recurring_tasks")
  @@index([taskId])
}

